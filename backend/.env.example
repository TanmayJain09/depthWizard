# Copy to .env and edit. NOTE: not read by the code yet (python-dotenv is
# installed, so wiring these up later is a small change).

HOST=0.0.0.0
PORT=8000

# Frontend dev server origin allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Where generated DSMs / confidence maps are written
OUTPUT_DIR=outputs

# Depth backbone (Small is what the experiments used)
MODEL_NAME=depth-anything/Depth-Anything-V2-Small-hf

# auto | cpu | cuda
DEVICE=auto